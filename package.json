{
  "name": "ecomax-esp32-gateway-installer",
  "version": "0.7.0-beta.4",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --config installer/vite.config.js --host 127.0.0.1",
    "build": "node tools/build_guide.mjs && vite build --config installer/vite.config.js && node tools/prepare_site.mjs",
    "docs": "node tools/build_guide.mjs",
    "test": "node --test tests/*.cjs tests/test_installer.mjs",
    "test:browser": "node tests/installer_browser.mjs"
  },
  "dependencies": {
    "esp-web-tools": "10.4.0",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "marked": "18.1.1",
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
